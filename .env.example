# Copia estas variables a .env.local para desarrollo local.
# En Vercel, agrégalas en Project Settings > Environment Variables.
# No guardes valores reales en este archivo ni uses NEXT_PUBLIC_ para secretos.

# Supabase: URL y clave pública para el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: clave privada usada por rutas y auditoría en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: clave privada usada por JRM IA y OCR en el servidor.
OPENAI_API_KEY=

# Opcionales: el código usa estos valores por defecto.
OPENAI_AI_MODEL=gpt-4.1-mini
AI_PROVIDER=openai
OPENAI_OCR_MODEL=gpt-4o

# Despliegues WMS separados: establecer JRM_APP=wms-staging o wms-production
# exclusivamente en el proyecto Vercel WMS correspondiente. Las variables Supabase
# de ese proyecto deben pertenecer a la misma base WMS. Ver docs/despliegue-wms.md.
# NEXT_PUBLIC_WMS_ZEBRA_VERIFIED_DPI=203 solo después de validar una Zebra física.
